# Copy to .env and adjust. Never commit .env.

APP_ENV=development
TZ=America/Sao_Paulo

# ── Database: two roles, deliberately ──────────────────────────────────────
# ADR-0004 makes the audit trail append-only with REVOKE UPDATE, DELETE plus a
# trigger. Both are void if the application connects as the table owner, because
# an owner can ALTER TABLE ... DISABLE TRIGGER, TRUNCATE, and re-GRANT itself
# UPDATE. So there are two roles and they are not interchangeable.

# Owner and migration role. Runs Alembic. Never serves a request.
POSTGRES_USER=sigi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigi
DATABASE_URL_ADMIN=postgresql+psycopg://sigi:change-me@db:5432/sigi

# Application role. Can read and write rows and nothing else: no DDL, no
# UPDATE or DELETE on the audit table, no DELETE on usuario. Created by
# ./infra/postgres/init/01-roles.sh on first container init; the migration
# refuses to run if it is missing.
APP_DB_ROLE=sigi_app
APP_DB_PASSWORD=change-me-too
DATABASE_URL=postgresql+psycopg://sigi_app:change-me-too@db:5432/sigi

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
